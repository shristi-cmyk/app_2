# Copy to .env for local use. On Embarko, set these in the project's environment variables.
VIASOCKET_ORG_ID=62791
VIASOCKET_PROJECT_ID=projC9zfc2g2
VIASOCKET_EMBED_SECRET=
# Password that protects this app (browser login prompt; username can be anything).
APP_PASSWORD=
# Where the app saves its small state file. Point at a persistent volume if the host has one.
DATA_DIR=./data
VIASOCKET_API_URL=https://flow-api.viasocket.com
# Partner Outreach: the AI that checks apps and drafts emails (Claude).
ANTHROPIC_API_KEY=

# EOD Reports (/eod). Its own viaSocket embed, separate from the one above.
EOD_VIASOCKET_ORG_ID=4160
EOD_VIASOCKET_PROJECT_ID=projOEUNHFgu
# From viaSocket -> Integrations -> the embed -> Install Code. Server only; never commit it.
EOD_VIASOCKET_EMBED_SECRET=
# The one company identity the admin connects Slack and Google Sheets under. Never change it once set.
EOD_WORKSPACE_UID=eod-workspace
# Signs the EOD sign-in cookie (any random string, 16+ characters).
EOD_SESSION_SECRET=
# The first admin: sign in to /eod with these once; then manage people under Settings.
EOD_ADMIN_EMAIL=
EOD_ADMIN_PASSWORD=
# Shared key the viaSocket end-of-day schedule sends to /api/eod/cron (random, 16+ characters).
EOD_CRON_KEY=
